# Salin file ini menjadi .env lalu isi dengan kredensial asli Anda
# ==========================================
# KONFIGURASI BOT TELEGRAM AUTO-ORDER (FREE)
# ==========================================
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
BOT_NAME=Hams Auto Order
URL_BOT=t.me/username_bot_anda
OWNER_ID=1234567890
OWNER_NAME=Nama Owner
OWNER_NUMBER=628xxxxxxxxxx
OWNER_USERNAME=username_telegram_owner
CHANNEL=https://t.me/channel_anda

# ==========================================
# FORCE SUBSCRIBE (WAJIB JOIN CHANNEL / GRUP)
# ==========================================
# Bot WAJIB dijadikan Admin di channel/grup target agar bisa cek member
FORCE_SUB_ENABLED=false
FORCE_SUB_CHANNEL_ENABLED=true
FORCE_SUB_CHANNEL=@channel_anda
FORCE_SUB_CHANNEL_URL=https://t.me/channel_anda
FORCE_SUB_GROUP_ENABLED=false
FORCE_SUB_GROUP=
FORCE_SUB_GROUP_URL=

# ==========================================
# VEYRA PAY QRIS PAYMENT GATEWAY (https://pay.veyra.id)
# ==========================================
VEYRA_BASE_URL=https://pay.veyra.id
APIKEY_VEYRA=YOUR_VEYRA_API_KEY
# Opsional: PIN Withdraw Veyra Pay (kosongkan jika ingin selalu ketik PIN manual di /withdraw)
VEYRA_WD_PIN=
VEYRA_EXPIRE_MINUTES=15

# Biaya admin tambahan bot (default 0 karena Veyra Pay sudah menambahkan kode unik otomatis)
QRIS_FEE_PERCENT=0
QRIS_FEE_FIXED=0

# Opsional: Webhook Real-Time Veyra Pay (ubah true jika deploy VPS HTTPS)
# Whitelist IP Server Veyra Pay: 103.177.100.55
VEYRA_WEBHOOK_ENABLED=false
VEYRA_WEBHOOK_PORT=3000
VEYRA_WEBHOOK_PATH=/veyra-webhook
VEYRA_WEBHOOK_SECRET=
